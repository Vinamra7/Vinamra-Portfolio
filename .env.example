# Public browser configuration. The Turnstile site key is NOT a secret.
# Set the same variables in Vercel, then rebuild/redeploy.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAFM5G55V3dNnE_Br

# InScope Worker origin used on vinamramishra.dev and www.vinamramishra.dev.
NEXT_PUBLIC_API_PRIMARY=https://api.vinamramishra.dev

# InScope Worker origin used on every other host, such as the Vercel preview
# domain. Replace <acct> with the Cloudflare account subdomain.
NEXT_PUBLIC_API_FALLBACK=https://inscope.<acct>.workers.dev

# InScope Worker origin used on localhost / 127.0.0.1 while developing.
NEXT_PUBLIC_API_LOCAL=http://localhost:8787

# Set to 1 to fake /api/session and /api/chat in the browser so the chat UI can
# be built and tested before the Worker is live. Keep 0 (or unset) otherwise.
NEXT_PUBLIC_INSCOPE_MOCK=0

# TURNSTILE_SECRET and AI provider keys belong only in the InScope Worker.
